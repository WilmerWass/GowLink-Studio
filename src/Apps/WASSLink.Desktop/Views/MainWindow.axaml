<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:WASSLink.Desktop.ViewModels"
        xmlns:models="using:WASSLink.Desktop.Models"
        x:Class="WASSLink.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1000"
        d:DesignHeight="680"
        Width="1020"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0F1015"
        Title="GowLink Studio — Downloader">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Root Grid: Sidebar + Content + Modal Overlay todo en col 1 del root -->
    <Grid ColumnDefinitions="250,*">

        <!-- ==================== BARRA LATERAL (SIDEBAR) ==================== -->
        <Border Grid.Column="0"
                Background="#161720"
                BorderBrush="#232534"
                BorderThickness="0,0,1,0"
                Padding="16,24">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Logo y Marca -->
                <StackPanel Grid.Row="0" Spacing="8" Margin="4,0,4,28">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Background="#6366F1"
                                CornerRadius="8"
                                Width="34"
                                Height="34">
                            <TextBlock Text="G"
                                       Foreground="White"
                                       FontWeight="Black"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="GowLink"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#F3F4F6" />
                            <TextBlock Text="STUDIO"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="2"
                                       Foreground="#818CF8" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Etiqueta de versión -->
                    <Border Background="#1E202E"
                            BorderBrush="#2F334A"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Left">
                        <TextBlock Text="Beta 1.4 — Universal Download Engine"
                                   FontSize="11"
                                   Foreground="#9CA3AF" />
                    </Border>
                </StackPanel>

                <!-- Menú de Navegación -->
                <StackPanel Grid.Row="1" Spacing="6">
                    <TextBlock Text="MÓDULOS"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#6B7280"
                               LetterSpacing="1"
                               Margin="8,0,0,6" />

                    <!-- Downloader (Activo) -->
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="#25283D"
                            BorderBrush="#6366F1"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="Downloader">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="📥" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Downloader" FontWeight="SemiBold" Foreground="#F9FAFB" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Background="#4F46E5" CornerRadius="4" Padding="6,2"
                                    IsVisible="{Binding IsDownloaderSelected}">
                                <TextBlock Text="Activo" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="#1F2130"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Command="{Binding OpenLibraryCommand}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="📚" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Biblioteca" Foreground="#D1D5DB" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Background="#4F46E5" CornerRadius="4" Padding="6,2"
                                    IsVisible="{Binding IsLibrarySelected}">
                                <TextBlock Text="Activo" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="#1F2130"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="Buscador">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Buscador" Foreground="#D1D5DB" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Background="#4F46E5" CornerRadius="4" Padding="6,2"
                                    IsVisible="{Binding IsSearchSelected}">
                                <TextBlock Text="Activo" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="#1F2130"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="Descargas">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="📋" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Lista de Descargas" Foreground="#D1D5DB" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Background="#4F46E5" CornerRadius="4" Padding="6,2"
                                    IsVisible="{Binding IsDownloadsSelected}">
                                <TextBlock Text="Activo" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="#1F2130"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Command="{Binding SelectSectionCommand}"
                            CommandParameter="Configuración">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="⚙" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Configuración" Foreground="#D1D5DB" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Background="#4F46E5" CornerRadius="4" Padding="6,2"
                                    IsVisible="{Binding IsSettingsSelected}">
                                <TextBlock Text="Activo" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Pie de barra lateral -->
                <StackPanel Grid.Row="2" Spacing="10">
                    <Border Background="#1A1C28"
                            BorderBrush="#272A3C"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8">
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveEngineLabel}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#E5E7EB" />
                            </StackPanel>
                            <TextBlock Text="{Binding EngineStatus}"
                                       FontSize="10"
                                       Foreground="#9CA3AF"
                                       Margin="13,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding OpenLogsFolderCommand}"
                            Background="#1A1C28"
                            BorderBrush="#374151"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8"
                            HorizontalAlignment="Stretch"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="📜" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="Abrir carpeta de Logs"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#E5E7EB"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="© GowLink Studio 2026"
                               FontSize="10"
                               Foreground="#4B5563"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== ÁREA PRINCIPAL ==================== -->
        <!-- Panel relativo para superponer el modal sobre el contenido -->
        <Panel Grid.Column="1">

            <!-- Contenido scrollable principal -->
            <ScrollViewer IsVisible="{Binding IsDownloaderFormVisible}">
                <StackPanel Margin="36,28" Spacing="24" MaxWidth="850" HorizontalAlignment="Stretch">

                    <!-- Cabecera de Página -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="GowLink Downloader"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#F9FAFB" />

                        <TextBlock Text="Descarga lo que quieras, cuando quieras y como quieras."
                                   FontSize="14"
                                   Foreground="#9CA3AF"
                                   FontStyle="Italic" />
                    </StackPanel>

                    <!-- Tarjeta Principal de Descarga -->
                    <Border Background="#161823"
                            BorderBrush="#25283A"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="28">
                        <StackPanel Spacing="20">

                            <TextBlock Text="Nueva descarga"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#F3F4F6" />

                            <!-- Entrada de URL -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Enlace del contenido (YouTube, etc.)"
                                           FontWeight="Medium"
                                           FontSize="13"
                                           Foreground="#D1D5DB" />

                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding DownloadUrl}"
                                             PlaceholderText="https://www.youtube.com/watch?v=..."
                                             MinHeight="44"
                                             FontSize="14"
                                             CornerRadius="8"
                                             BorderBrush="#31354C"
                                             Background="#1D2030"
                                             Foreground="#F9FAFB" />

                                            <Button Grid.Column="1"
                                                Width="44"
                                                Height="44"
                                                Command="{Binding ClearDownloadUrlCommand}"
                                                IsEnabled="{Binding !IsDownloading}"
                                                Background="#25283D"
                                                BorderBrush="#374151"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                ToolTip.Tip="Limpiar enlace"
                                                Cursor="Hand">
                                            <TextBlock Text="✕"
                                                   FontSize="16"
                                                   Foreground="#FCA5A5"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                            </Button>

                                            <Button Grid.Column="2"
                                            Command="{Binding PasteFromClipboardCommand}"
                                            Background="#25283D"
                                            BorderBrush="#4F46E5"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,10"
                                            ToolTip.Tip="Pegar enlace desde el portapapeles"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="📋" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Text="Pegar" FontWeight="SemiBold" FontSize="13" Foreground="#E0E7FF" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <Button Content="Analizar"
                                    Command="{Binding AnalyzeCommand}"
                                    IsEnabled="{Binding !IsDownloading}"
                                    HorizontalAlignment="Center"
                                    MinWidth="240"
                                    Background="{Binding AccentColor}"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    FontSize="14"
                                    Padding="24,12"
                                    CornerRadius="8"
                                    Cursor="Hand" />

                            <!-- Carpeta de Descargas -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="Destino de guardado"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="#D1D5DB" />

                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Border Grid.Column="0"
                                            Background="#1B1D2B"
                                            BorderBrush="#2B2F44"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,9">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0" Text="📁 " FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding OutputPath}"
                                                       FontSize="12"
                                                       Foreground="#9CA3AF"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>

                                    <!-- Botón Examinar -->
                                    <Button Grid.Column="1"
                                            Command="{Binding BrowseFolderCommand}"
                                            IsEnabled="{Binding !IsDownloading}"
                                            Background="#25283D"
                                            BorderBrush="#4F46E5"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,9"
                                            ToolTip.Tip="Elegir carpeta de destino"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="📂" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Text="Examinar" FontSize="12" FontWeight="SemiBold" Foreground="#E0E7FF" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Botón Abrir carpeta -->
                                    <Button Grid.Column="2"
                                            Command="{Binding OpenOutputFolderCommand}"
                                            IsEnabled="{Binding !IsDownloading}"
                                            Background="#1B1D2B"
                                            BorderBrush="#374151"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Width="40"
                                            Height="38"
                                            ToolTip.Tip="Abrir carpeta en el explorador"
                                            Cursor="Hand">
                                        <TextBlock Text="↗" FontSize="15" FontWeight="Bold" Foreground="#6B7280"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Botones de Acción -->
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                <Button Content="Cancelar"
                                        Command="{Binding CancelDownloadCommand}"
                                        IsEnabled="{Binding IsDownloading}"
                                        IsVisible="{Binding IsDownloading}"
                                        Background="#371E2B"
                                        BorderBrush="#EF4444"
                                        BorderThickness="1"
                                        Foreground="#F87171"
                                        FontWeight="SemiBold"
                                        FontSize="14"
                                        Padding="20,12"
                                        CornerRadius="8"
                                        Cursor="Hand" />
                            </StackPanel>

                            <!-- Separador -->
                            <Border Height="1" Background="#242636" Margin="0,4" />

                            <!-- Estado y Progreso -->
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding StatusMessage}"
                                               FontSize="13"
                                               Foreground="#E5E7EB"
                                               TextWrapping="Wrap" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DownloadProgress, StringFormat='{}{0:F0}%'}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#818CF8"
                                               Margin="8,0,0,0"
                                               IsVisible="{Binding IsPhaseDownloading}" />
                                </Grid>

                                <!-- Barra normal (descargando %) -->
                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Value="{Binding DownloadProgress}"
                                             Height="8"
                                             CornerRadius="4"
                                             Background="#23263B"
                                             Foreground="#6366F1"
                                             IsVisible="{Binding !IsPhaseProcessing}" />

                                <!-- Barra indeterminada (fase FFmpeg / muxing) -->
                                <ProgressBar IsIndeterminate="True"
                                             Height="8"
                                             CornerRadius="4"
                                             Background="#23263B"
                                             Foreground="#F59E0B"
                                             IsVisible="{Binding IsPhaseProcessing}" />

                                <!-- Etiqueta animada de fase FFmpeg -->
                                <Border Background="#1F1A0D"
                                        BorderBrush="#78350F"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        IsVisible="{Binding IsPhaseProcessing}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="⚙"
                                                   FontSize="13"
                                                   Foreground="#F59E0B"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Procesando con FFmpeg — esto puede tardar unos segundos..."
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FDE68A"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Telemetría en vivo -->
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0"
                                      IsVisible="{Binding IsPhaseDownloading}">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <Border Background="#1F2335"
                                                BorderBrush="#2C324D"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                IsVisible="{Binding !!CurrentSpeed.Length}">
                                            <TextBlock Text="{Binding CurrentSpeed, StringFormat='⚡ {0}'}"
                                                       FontSize="11"
                                                       Foreground="#38BDF8"
                                                       FontWeight="SemiBold" />
                                        </Border>

                                        <Border Background="#1F2335"
                                                BorderBrush="#2C324D"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                IsVisible="{Binding !!CurrentSize.Length}">
                                            <TextBlock Text="{Binding CurrentSize, StringFormat='📦 {0}'}"
                                                       FontSize="11"
                                                       Foreground="#A78BFA"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Background="#1F2335"
                                            BorderBrush="#2C324D"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            IsVisible="{Binding !!CurrentEta.Length}">
                                        <TextBlock Text="{Binding CurrentEta, StringFormat='⏱ {0}'}"
                                                   FontSize="11"
                                                   Foreground="#FBBF24"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsSearchSelected}">
                <StackPanel Margin="36,28" Spacing="24" MaxWidth="850" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Buscador"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#F9FAFB" />
                        <TextBlock Text="Busca archivos guardados por nombre y consulta enlaces multimedia."
                                   FontSize="14"
                                   Foreground="#9CA3AF" />
                    </StackPanel>

                    <Border Background="#161823"
                            BorderBrush="#25283A"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="28">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Buscar en biblioteca o consultar URL"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#F3F4F6" />
                            <TextBox Text="{Binding SearchQuery}"
                                     PlaceholderText="Nombre de archivo o URL"
                                     MinHeight="44"
                                     FontSize="14"
                                     CornerRadius="8"
                                     BorderBrush="#31354C"
                                     Background="#1D2030"
                                     Foreground="#F9FAFB" />
                            <WrapPanel>
                                <CheckBox Content="Imágenes" IsChecked="{Binding SearchImages}" Margin="0,0,14,8" />
                                <CheckBox Content="Audio" IsChecked="{Binding SearchAudio}" Margin="0,0,14,8" />
                                <CheckBox Content="Vídeo" IsChecked="{Binding SearchVideo}" Margin="0,0,14,8" />
                                <CheckBox Content="Archivos/Compressed" IsChecked="{Binding SearchCompressed}" Margin="0,0,14,8" />
                                <CheckBox Content="ISO" IsChecked="{Binding SearchIso}" Margin="0,0,14,8" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Buscar archivos"
                                        Command="{Binding SearchLocalFilesCommand}"
                                        Background="{Binding AccentColor}"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        Padding="18,11"
                                        CornerRadius="8" />
                            <Button Content="Consultar enlace"
                                    Command="{Binding SearchCommand}"
                                    IsEnabled="{Binding !IsSearching}"
                                    Background="#25283D"
                                    BorderBrush="#4F46E5"
                                    BorderThickness="1"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Padding="18,11"
                                    CornerRadius="8" />
                            </StackPanel>
                            <ProgressBar IsIndeterminate="True"
                                         IsVisible="{Binding IsSearching}"
                                         Height="5"
                                         Foreground="#6366F1"
                                         Background="#23263B" />
                            <Border Background="#1B1D2B"
                                    BorderBrush="#2B2F44"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding SearchResultMessage}"
                                               Foreground="#E5E7EB"
                                               FontSize="13"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ActiveEngineLabel}"
                                               Foreground="#818CF8"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <Button Content="Abrir en Downloader"
                                            Command="{Binding DownloadSearchedLinkCommand}"
                                            IsVisible="{Binding !HasSearchResults}"
                                            HorizontalAlignment="Left"
                                            Background="#25283D"
                                            BorderBrush="#4F46E5"
                                            BorderThickness="1"
                                            Foreground="#E0E7FF"
                                            Padding="14,8"
                                            CornerRadius="7" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding LocalSearchResults}"
                                          IsVisible="{Binding HasSearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:LocalFileItem">
                                        <Button Command="{Binding $parent[Window].DataContext.OpenLocalFileCommand}"
                                                CommandParameter="{Binding}"
                                                HorizontalContentAlignment="Stretch"
                                                Background="#161823"
                                                BorderBrush="#25283A"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,10"
                                                Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                                                <TextBlock Text="{Binding Name}" Foreground="#E5E7EB" />
                                                <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="#9CA3AF" />
                                                <TextBlock Grid.Column="2" Text="{Binding Size}" Foreground="#818CF8" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsLibrarySelected}">
                <StackPanel Margin="36,28" Spacing="24" MaxWidth="850" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Biblioteca"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#F9FAFB" />
                            <TextBlock Text="{Binding LibraryStatus}"
                                       FontSize="13"
                                       Foreground="#9CA3AF"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Actualizar"
                                Command="{Binding RefreshLibraryCommand}"
                                Background="{Binding AccentColor}"
                                Foreground="White"
                                Padding="16,10"
                                CornerRadius="8" />
                    </Grid>
                    <TextBlock Text="{Binding OutputPath}"
                               Foreground="#818CF8"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <ItemsControl ItemsSource="{Binding LibraryFiles}"
                                  IsVisible="{Binding HasLibraryFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LocalFileItem">
                                <Button Command="{Binding $parent[Window].DataContext.OpenLocalFileCommand}"
                                        CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Stretch"
                                        Background="#161823"
                                        BorderBrush="#25283A"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14">
                                        <TextBlock Text="{Binding Name}" Foreground="#E5E7EB" />
                                        <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="#9CA3AF" />
                                        <TextBlock Grid.Column="2" Text="{Binding Size}" Foreground="#818CF8" />
                                        <TextBlock Grid.Column="3" Text="{Binding Modified, StringFormat='{}{0:g}'}" Foreground="#6B7280" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border IsVisible="{Binding !HasLibraryFiles}"
                            Background="#161823"
                            CornerRadius="10"
                            Padding="24">
                        <TextBlock Text="La carpeta todavía no contiene archivos."
                                   Foreground="#D1D5DB"
                                   HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsDownloadsSelected}">
                <StackPanel Margin="36,28" Spacing="24" MaxWidth="850" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Lista de Descargas"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#F9FAFB" />
                            <TextBlock Text="Progreso, motor y resultado de las descargas de esta sesión."
                                       FontSize="14"
                                       Foreground="#9CA3AF" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Nueva descarga"
                                Command="{Binding SelectSectionCommand}"
                                CommandParameter="Downloader"
                                Background="{Binding AccentColor}"
                                Foreground="White"
                                Padding="16,10"
                                CornerRadius="8" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding DownloadTypeFilters}"
                                  SelectedItem="{Binding DownloadTypeFilter}"
                                  MinWidth="140"
                                  PlaceholderText="Tipo">
                        </ComboBox>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DownloadDateFilters}"
                                  SelectedItem="{Binding DownloadDateFilter}"
                                  MinWidth="140"
                                  PlaceholderText="Fecha">
                        </ComboBox>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding SelectedDownloadCount, StringFormat='{}Seleccionados: {0}'}"
                                   VerticalAlignment="Center"
                                   Foreground="#9CA3AF" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                            <Button Content="Pausar seleccionadas"
                                    Command="{Binding PauseSelectedDownloadsCommand}"
                                    IsEnabled="{Binding CanPauseSelectedDownloads}"
                                    ToolTip.Tip="Pausa/reanuda descargas HTTP activas seleccionadas. yt-dlp no admite pausa."
                                    Background="#25283D"
                                    Foreground="#D1D5DB"
                                    Padding="12,8"
                                    CornerRadius="7" />
                            <Button Content="Quitar del historial"
                                    Command="{Binding DeleteSelectedDownloadsCommand}"
                                    IsEnabled="{Binding HasSelectedDownloads}"
                                    Background="#371E2B"
                                    BorderBrush="#7F1D1D"
                                    BorderThickness="1"
                                    Foreground="#FCA5A5"
                                    Padding="12,8"
                                    CornerRadius="7" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="12"
                                IsVisible="{Binding HasFilteredDownloads}">
                        <ItemsControl ItemsSource="{Binding FilteredDownloadHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DownloadHistoryItem">
                                    <Border Background="#161823"
                                            BorderBrush="#25283A"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16"
                                            Margin="0,0,0,10">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Abrir con..."
                                                          Command="{Binding $parent[Window].DataContext.OpenDownloadedWithCommand}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Abrir ubicación"
                                                          Command="{Binding $parent[Window].DataContext.OpenDownloadedLocationCommand}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0" />
                                            <StackPanel Grid.Column="1" Spacing="8">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding SourceUrl}"
                                                               Foreground="#E5E7EB"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Progress, StringFormat='{}{0:F0}%'}"
                                                               Foreground="#818CF8"
                                                               FontWeight="Bold" />
                                                </Grid>
                                                <ProgressBar Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding Progress}"
                                                             Height="6"
                                                             Foreground="#6366F1"
                                                             Background="#23263B" />
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding Engine}"
                                                               Foreground="#9CA3AF"
                                                               FontSize="11" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Status}"
                                                               Foreground="#A5B4FC"
                                                               FontSize="11" />
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding Output}"
                                                               Foreground="#6B7280"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding CreatedAt, StringFormat='{}{0:g}'}"
                                                               Foreground="#6B7280"
                                                               FontSize="11" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border IsVisible="{Binding !HasDownloadHistory}"
                            Background="#161823"
                            BorderBrush="#25283A"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="28">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="Todavía no hay descargas en esta sesión."
                                       Foreground="#D1D5DB"
                                       FontSize="14" />
                            <Button Content="Iniciar una descarga"
                                    Command="{Binding SelectSectionCommand}"
                                    CommandParameter="Downloader"
                                    HorizontalAlignment="Center"
                                    Background="#4F46E5"
                                    Foreground="White"
                                    Padding="16,9"
                                    CornerRadius="8" />
                        </StackPanel>
                    </Border>
                    <Border IsVisible="{Binding ShowNoFilteredDownloads}"
                            Background="#161823"
                            CornerRadius="10"
                            Padding="24">
                        <TextBlock Text="No hay descargas que coincidan con esos filtros."
                                   Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsSettingsSelected}">
                <StackPanel Margin="36,28" Spacing="24" MaxWidth="850" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Configuración"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#F9FAFB" />
                        <TextBlock Text="Preferencias de la aplicación y rutas de descarga."
                                   FontSize="14"
                                   Foreground="#9CA3AF" />
                    </StackPanel>

                    <Border Background="#161823"
                            BorderBrush="#25283A"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="24">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Carpeta de destino"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#F3F4F6" />
                            <TextBlock Text="Las nuevas descargas se guardarán en esta ubicación. La carpeta predeterminada es Downloads\\GowLink."
                                       FontSize="13"
                                       Foreground="#9CA3AF"
                                       TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0"
                                         Text="{Binding OutputPath}"
                                         MinHeight="42"
                                         VerticalContentAlignment="Center"
                                         Background="#1D2030"
                                         Foreground="#F9FAFB"
                                         BorderBrush="#31354C" />
                                <Button Grid.Column="1"
                                        Content="Examinar"
                                        Command="{Binding BrowseFolderCommand}"
                                        Background="#25283D"
                                        BorderBrush="#4F46E5"
                                        BorderThickness="1"
                                        Foreground="#E0E7FF"
                                        Padding="16,9"
                                        CornerRadius="8" />
                            </Grid>
                            <TextBlock Text="Motor activo para el enlace actual"
                                       Foreground="#9CA3AF"
                                       FontSize="12" />
                            <TextBlock Text="{Binding ActiveEngineLabel}"
                                       Foreground="#818CF8"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Límite de velocidad (KB/s; 0 = sin límite)"
                                       Foreground="#9CA3AF"
                                       FontSize="12" />
                            <TextBox Text="{Binding DownloadSpeedLimitKbps}"
                                     MinHeight="40"
                                     Background="#1D2030"
                                     Foreground="#F9FAFB"
                                     BorderBrush="#31354C" />
                            <TextBlock Text="Color de acento"
                                       Foreground="#9CA3AF"
                                       FontSize="12" />
                            <ComboBox ItemsSource="{Binding AccentColorOptions}"
                                      SelectedItem="{Binding AccentColor}"
                                      HorizontalAlignment="Left"
                                      MinWidth="200">
                            </ComboBox>
                            <Button Content="Guardar preferencias"
                                    Command="{Binding SaveSettingsCommand}"
                                    Background="{Binding AccentColor}"
                                    Foreground="White"
                                    Padding="18,10"
                                    CornerRadius="8"
                                    HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding SettingsMessage}"
                                       Foreground="#A5B4FC"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsDownloadConfirmation}">
                <StackPanel Margin="36,28" Spacing="24" MaxWidth="850" HorizontalAlignment="Stretch">
                    <TextBlock Text="Descarga completada"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#F9FAFB" />
                    <Border Background="#161823"
                            BorderBrush="#25283A"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="32">
                        <StackPanel Spacing="18">
                            <Border Width="84"
                                    Height="84"
                                    CornerRadius="16"
                                    Background="#1E2035"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="✓"
                                           FontSize="42"
                                           FontWeight="Bold"
                                           Foreground="#4ADE80"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding ConfirmationTitle}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#F9FAFB"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ConfirmationDetails}"
                                       Foreground="#9CA3AF"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ConfirmationOutput}"
                                       Foreground="#818CF8"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="10">
                                <Button Content="Ir a la Biblioteca"
                                        Command="{Binding OpenLibraryCommand}"
                                        Background="{Binding AccentColor}"
                                        Foreground="White"
                                        Padding="14,10"
                                        CornerRadius="8" />
                                <Button Content="Ir a Lista de Descargas"
                                        Command="{Binding OpenDownloadsCommand}"
                                        Background="#25283D"
                                        BorderBrush="#4F46E5"
                                        BorderThickness="1"
                                        Foreground="#E0E7FF"
                                        Padding="14,10"
                                        CornerRadius="8" />
                                <Button Content="Pegar otro enlace"
                                        Command="{Binding PasteAnotherLinkCommand}"
                                        Background="#25283D"
                                        BorderBrush="#374151"
                                        BorderThickness="1"
                                        Foreground="#E0E7FF"
                                        Padding="14,10"
                                        CornerRadius="8" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== MODAL QUALITY GRID ==================== -->
            <!-- Overlay de fondo oscuro semi-transparente -->
            <Border IsVisible="{Binding IsFormatModalOpen}"
                    Background="#B20F1015"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">

                <!-- Tarjeta modal centrada -->
                <Border Background="#161823"
                        BorderBrush="#3C3F5A"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="28"
                        MaxWidth="740"
                        MaxHeight="580"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">

                        <!-- ── Cabecera del modal ── -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="🎛  Selección de Formato y Calidad"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#F9FAFB" />
                                <TextBlock Text="Elige exactamente cómo quieres descargar el contenido"
                                           FontSize="12"
                                           Foreground="#9CA3AF" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="✕"
                                    Command="{Binding CloseModalCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#6B7280"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    VerticalAlignment="Top" />
                        </Grid>

                        <!-- ── Cuerpo scrollable del modal ── -->
                        <ScrollViewer Grid.Row="1">
                            <StackPanel Spacing="24">

                                <!-- Estado de carga -->
                                <StackPanel IsVisible="{Binding IsLoadingFormats}"
                                            HorizontalAlignment="Center"
                                            Spacing="12"
                                            Margin="0,16">
                                    <TextBlock Text="⏳  Analizando formatos disponibles..."
                                               FontSize="14"
                                               Foreground="#9CA3AF"
                                               HorizontalAlignment="Center" />
                                    <ProgressBar IsIndeterminate="True"
                                                 Width="280"
                                                 Height="4"
                                                 CornerRadius="2"
                                                 Foreground="#6366F1"
                                                 Background="#23263B" />
                                </StackPanel>

                                <!-- Error de carga -->
                                <Border IsVisible="{Binding !!FormatLoadError.Length}"
                                        Background="#2D1F1F"
                                        BorderBrush="#7F1D1D"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10">
                                    <TextBlock Text="{Binding FormatLoadError}"
                                               Foreground="#FCA5A5"
                                               FontSize="13"
                                               TextWrapping="Wrap" />
                                </Border>

                                <!-- ── GRUPO AUDIO ── -->
                                <StackPanel IsVisible="{Binding !!AudioOptions.Count}"
                                            Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="🎵"
                                                   FontSize="15"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Música / Audio solo"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#818CF8"
                                                   VerticalAlignment="Center" />
                                        <Border Background="#1E2035"
                                                CornerRadius="4"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding AudioOptions.Count, StringFormat='{}{0} opciones'}"
                                                       FontSize="11"
                                                       Foreground="#6366F1" />
                                        </Border>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding AudioOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:MediaFormatOption">
                                                <Button Width="176"
                                                        Height="108"
                                                        Margin="0,0,10,10"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Command="{Binding $parent[Window].DataContext.SelectFormatCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Border Width="174"
                                                            Height="106"
                                                            CornerRadius="12"
                                                            Padding="14,12"
                                                            Background="#1A1C30">
                                                        <Border.Styles>
                                                            <Style Selector="Border">
                                                                <Setter Property="BorderBrush" Value="#2C2F4A" />
                                                                <Setter Property="BorderThickness" Value="1.5" />
                                                            </Style>
                                                            <Style Selector="Border.recommended">
                                                                <Setter Property="BorderBrush" Value="#6366F1" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                            </Style>
                                                            <Style Selector="Border.selected">
                                                                <Setter Property="BorderBrush" Value="#22D3EE" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                            </Style>
                                                        </Border.Styles>
                                                        <Grid RowDefinitions="Auto,*,Auto">

                                                            <!-- Badge recomendado -->
                                                            <Border Grid.Row="0"
                                                                    Background="#4F46E5"
                                                                    CornerRadius="4"
                                                                    Padding="7,2"
                                                                    HorizontalAlignment="Left"
                                                                    IsVisible="{Binding IsRecommended}">
                                                                <TextBlock Text="★  Recomendado"
                                                                           FontSize="9"
                                                                           FontWeight="Bold"
                                                                           Foreground="White" />
                                                            </Border>

                                                            <!-- Info principal -->
                                                            <StackPanel Grid.Row="1"
                                                                        VerticalAlignment="Center"
                                                                        Spacing="2">
                                                                <TextBlock Text="{Binding QualityLabel}"
                                                                           FontSize="18"
                                                                           FontWeight="Bold"
                                                                           Foreground="#F9FAFB" />
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="{Binding Extension}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#818CF8" />
                                                                    <TextBlock Text="·"
                                                                               FontSize="12"
                                                                               Foreground="#4B5563" />
                                                                    <TextBlock Text="{Binding Codec}"
                                                                               FontSize="12"
                                                                               Foreground="#6B7280" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Tamaño estimado -->
                                                            <TextBlock Grid.Row="2"
                                                                       Text="{Binding FormattedSize}"
                                                                       FontSize="11"
                                                                       Foreground="#6B7280"
                                                                       HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- ── GRUPO VIDEO ── -->
                                <StackPanel IsVisible="{Binding !!VideoOptions.Count}"
                                            Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="🎬"
                                                   FontSize="15"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Vídeo completo"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#38BDF8"
                                                   VerticalAlignment="Center" />
                                        <Border Background="#1A2535"
                                                CornerRadius="4"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding VideoOptions.Count, StringFormat='{}{0} opciones'}"
                                                       FontSize="11"
                                                       Foreground="#38BDF8" />
                                        </Border>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding VideoOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:MediaFormatOption">
                                                <Button Width="176"
                                                        Height="108"
                                                        Margin="0,0,10,10"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Command="{Binding $parent[Window].DataContext.SelectFormatCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Border Width="174"
                                                            Height="106"
                                                            CornerRadius="12"
                                                            Padding="14,12"
                                                            Background="#151C2A">
                                                        <Border.Styles>
                                                            <Style Selector="Border">
                                                                <Setter Property="BorderBrush" Value="#1E2D40" />
                                                                <Setter Property="BorderThickness" Value="1.5" />
                                                            </Style>
                                                        </Border.Styles>
                                                        <Grid RowDefinitions="Auto,*,Auto">

                                                            <!-- Badge recomendado -->
                                                            <Border Grid.Row="0"
                                                                    Background="#0E7490"
                                                                    CornerRadius="4"
                                                                    Padding="7,2"
                                                                    HorizontalAlignment="Left"
                                                                    IsVisible="{Binding IsRecommended}">
                                                                <TextBlock Text="★  Recomendado"
                                                                           FontSize="9"
                                                                           FontWeight="Bold"
                                                                           Foreground="White" />
                                                            </Border>

                                                            <!-- Info principal -->
                                                            <StackPanel Grid.Row="1"
                                                                        VerticalAlignment="Center"
                                                                        Spacing="2">
                                                                <TextBlock Text="{Binding QualityLabel}"
                                                                           FontSize="18"
                                                                           FontWeight="Bold"
                                                                           Foreground="#F0F9FF" />
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="{Binding Extension}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#38BDF8" />
                                                                    <TextBlock Text="·"
                                                                               FontSize="12"
                                                                               Foreground="#374151" />
                                                                    <TextBlock Text="{Binding Codec}"
                                                                               FontSize="12"
                                                                               Foreground="#6B7280" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <!-- Tamaño estimado -->
                                                            <TextBlock Grid.Row="2"
                                                                       Text="{Binding FormattedSize}"
                                                                       FontSize="11"
                                                                       Foreground="#6B7280"
                                                                       HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- Placeholder cuando no hay formatos y no está cargando -->
                                <StackPanel IsVisible="{Binding !HasFormats}"
                                            HorizontalAlignment="Center"
                                            Spacing="8"
                                            Margin="0,20">
                                    <TextBlock Text="Sin formatos cargados"
                                               FontSize="14"
                                               Foreground="#4B5563"
                                               HorizontalAlignment="Center" />
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- ── Pie del modal: selección activa + botón confirmar ── -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">

                            <!-- Indicador de selección activa -->
                            <Border Grid.Column="0"
                                    Background="#1E2035"
                                    BorderBrush="#2C324D"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    IsVisible="{Binding SelectedFormatOption, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="✔"
                                               FontSize="13"
                                               Foreground="#10B981"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedFormatLabel}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#E0E7FF"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Botón Confirmar -->
                            <Button Grid.Column="1"
                                    Content="Confirmar y Descargar →"
                                    Command="{Binding ConfirmSelectionCommand}"
                                    IsEnabled="{Binding SelectedFormatOption, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Background="#4F46E5"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    FontSize="14"
                                    Padding="22,12"
                                    CornerRadius="8"
                                    Cursor="Hand" />
                        </Grid>

                    </Grid>
                </Border>
            </Border>
            <!-- ==================== FIN MODAL ==================== -->

            <!-- ==================== TOAST DE COMPLETADO ==================== -->
            <Border IsVisible="{Binding IsToastVisible}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,24,24"
                    MaxWidth="380"
                    Background="#0F2E1E"
                    BorderBrush="#166534"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                    <!-- Icono check -->
                    <Border Grid.Column="0"
                            Background="#14532D"
                            CornerRadius="20"
                            Width="40"
                            Height="40">
                        <TextBlock Text="✓"
                                   FontSize="20"
                                   FontWeight="Black"
                                   Foreground="#4ADE80"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Texto -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="¡Descarga completada!"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#BBF7D0" />
                        <TextBlock Text="{Binding ToastTitle}"
                                   FontSize="12"
                                   Foreground="#86EFAC"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="220" />
                        <TextBlock Text="{Binding ToastSubtitle}"
                                   FontSize="11"
                                   Foreground="#4B5563"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="220" />
                    </StackPanel>

                    <!-- Cerrar -->
                    <Button Grid.Column="2"
                            Command="{Binding DismissToastCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#4B5563"
                            FontSize="16"
                            FontWeight="Bold"
                            VerticalAlignment="Top"
                            Cursor="Hand"
                            Content="✕" />
                </Grid>
            </Border>
            <!-- ==================== FIN TOAST ==================== -->

            <Border IsVisible="{Binding IsAnalyzing}"
                    Background="#B20F1015"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Border Background="#161823"
                        BorderBrush="#3C3F5A"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="28"
                        MaxWidth="340"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <TextBlock Text="Analizando..."
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#F9FAFB"
                                   HorizontalAlignment="Center" />
                        <ProgressBar IsIndeterminate="True"
                                     Width="250"
                                     Height="6"
                                     Foreground="{Binding AccentColor}"
                                     Background="#23263B" />
                    </StackPanel>
                </Border>
            </Border>

        </Panel>

    </Grid>

</Window>